# ─── Supabase (required) ──────────────────────────────────────────────────
# Create a free project at https://supabase.com. Settings → API.
# SUPABASE_URL / SUPABASE_SERVICE_ROLE_KEY are server-side only (api/).
# VITE_SUPABASE_URL / VITE_SUPABASE_ANON_KEY are public, sent to the client.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...

# ─── Team branding (required) ─────────────────────────────────────────────
# iOS home-screen icon label must be ≤12 chars to avoid truncation.
# VITE_SCHOOL_LOGO is optional (URL); blank uses the local /team-logo.png.
# VITE_BRAND_PRIMARY/ACCENT need a leading # (do not wrap in quotes).
VITE_TEAM_NAME=Riverdale XC/TF
VITE_SHORT_NAME=Riverdale
VITE_SCHOOL_NAME=Riverdale High
VITE_SCHOOL_LOGO=
VITE_BRAND_PRIMARY="#002776"
VITE_BRAND_ACCENT="#2cccd3"

# ─── Coach access ─────────────────────────────────────────────────────────
# Comma-separated emails that get write access to the coach dashboard.
VITE_AUTHORIZED_COACHES=coach@example.com,assistant@example.com

# Domain athletes' Google accounts must come from for self-log email
# auto-bind to work. Leave empty to disable auto-bind (coaches fill
# roster.email by hand).
ALLOWED_EMAIL_DOMAIN=

# ─── Google Sheets (optional — legacy data source) ────────────────────────
# Only needed if migrating from the original sheet-based version. New
# deploys leave these blank.
VITE_SHEET_ID=
VITE_WORKOUT_GID=0
VITE_ROSTER_GID=197184629

# ─── Strava (optional — for per-athlete activity sync) ────────────────────
# Create an app at https://www.strava.com/settings/api.
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
# Any long random string. Vercel auto-sends "Authorization: Bearer <this>"
# on scheduled cron invocations, so the team-sync endpoint can reject
# arbitrary callers.
CRON_SECRET=

# ─── Local-only utilities (NOT for production) ────────────────────────────
# Used by scripts/scrape-strava-feed.mjs. Grab _strava4_session from
# DevTools → Application → Cookies on strava.com.
STRAVA_SESSION_COOKIE=
STRAVA_MY_ATHLETE_ID=
